APP_NAME=AlDia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# GOOGLE OAUTH (Socialite / SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# FACEBOOK OAUTH (Socialite / SSO)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# TELEGRAM - Notifications
TELEGRAM_DEFAULT_CHAT_ID=

# TELEGRAM LOGIN (inicio de sesion con Telegram - socialiteproviders/telegram)
# Crea el bot en @BotFather y ejecuta /setdomain con el dominio HTTPS de la app
TELEGRAM_LOGIN_BOT_NAME=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_REDIRECT_URI=http://localhost:8000/auth/telegram/callback

# WHATSAPP - Notifications
WHATSAPP_DEFAULT_TO=
WHATSAPP_VERIFY_TOKEN=

# N8N - Workflow Automation
# N8N_API_TOKEN: token global que protege /api/v1/telegram/check-linking y
#   /api/internal/* via header X-N8N-TOKEN. Los workflows n8n deben enviarlo.
# N8N_TELEGRAM_PROXY_URL: webhook de produccion del workflow "telegram-proxy".
N8N_API_TOKEN=
N8N_WEBHOOK_URL=
N8N_BASE_URL=
N8N_TELEGRAM_PROXY_URL=https://n8n.redcliente.cl/webhook/telegram-proxy

# HTTP_VERIFY_TLS: verifica certificados TLS en llamadas salientes (default true).
#   Solo deshabilitar en desarrollo local (Windows sin CA bundle): HTTP_VERIFY_TLS=false
HTTP_VERIFY_TLS=true

# LLM - Asistente IA de Telegram (opcional)
# Con LLM_ENABLED=true, los mensajes de chats vinculados los responde este
# asistente (endpoint compatible con OpenAI). Si el LLM falla, el mensaje se
# reenvia a n8n automaticamente (fallback).
LLM_ENABLED=false
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=500
LLM_MEMORY_WINDOW=20

# MAILTRAP - Email Testing
MAILTRAP_API_TOKEN=

# REDIS - Cache & Queues
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1

# REVERB - WebSockets (Broadcasting)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# CORS - Allowed Origins (comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# SESSION
SESSION_SECURE_COOKIE=true

# SII - Certificado Digital (.pfx)
# Sube el archivo a storage/app/sii/ y NO lo incluyas en Git (.gitignore).
SII_CERT_PATH=
SII_CERT_PASSWORD=
SII_RUT_EMISOR=

# SII - Web Services SOAP
# Ambiente de Certificacion (Pruebas) - ACTIVO
SII_SEMILLA_URL=https://maullin.sii.cl/cgi_rtc/RTC/getest01.cgi
SII_TOKEN_URL=https://maullin.sii.cl/cgi_rtc/RTC/getest02.cgi
SII_ENVIO_DTE_URL=https://maullin.sii.cl/cgi_rtc/RTC/recrecep01.cgi

# Ambiente de Produccion (Real) - COMENTADO
# SII_SEMILLA_URL=https://palena.sii.cl/cgi_rtc/RTC/gettoken.cgi
# SII_TOKEN_URL=https://palena.sii.cl/cgi_rtc/RTC/gettoken.cgi
# SII_ENVIO_DTE_URL=https://palena.sii.cl/cgi_rtc/RTC/recrecep01.cgi
