# ============================================================================
# AlDia - Plantilla de entorno de PRODUCCIÓN
#
# Uso:
#   cp .env.production.example .env.production
#   # rellena todos los CHANGE_ME y ejecuta deploy/deploy.sh
#
# .env.production NO se versiona (ver .gitignore). Esta plantilla sí.
# El script de despliegue la copia a .env solo en el primer despliegue.
# ============================================================================

APP_NAME=AlDia
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://aldiaproyect.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# database o redis (si usas redis, ajusta REDIS_* y los workers de Supervisor)
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# GOOGLE OAUTH (Socialite / SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://aldiaproyect.com/auth/google/callback

# FACEBOOK OAUTH (Socialite / SSO)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://aldiaproyect.com/auth/facebook/callback

# TELEGRAM - Notifications
TELEGRAM_DEFAULT_CHAT_ID=

# TELEGRAM LOGIN (socialiteproviders/telegram)
TELEGRAM_LOGIN_BOT_NAME=
TELEGRAM_LOGIN_BOT_TOKEN=
TELEGRAM_LOGIN_REDIRECT_URI=https://aldiaproyect.com/auth/telegram/callback

# WHATSAPP - Notifications
WHATSAPP_DEFAULT_TO=
WHATSAPP_VERIFY_TOKEN=

# N8N - Workflow Automation
N8N_API_TOKEN=
N8N_WEBHOOK_URL=
N8N_BASE_URL=
N8N_TELEGRAM_PROXY_URL=https://n8n.redcliente.cl/webhook/telegram-proxy

# HTTP_VERIFY_TLS: verifica certificados TLS en llamadas salientes.
HTTP_VERIFY_TLS=true

# LLM - Asistente IA de Telegram (opcional)
LLM_ENABLED=false
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=500
LLM_MEMORY_WINDOW=20

# OPENROUTER - NUNCA versionar el valor real.
OPENROUTER_API_KEY=

# MAILTRAP - Email Testing
MAILTRAP_API_TOKEN=

# REDIS - Cache & Queues (opcional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1

# REVERB - WebSockets (Broadcasting)
# REVERB_HOST/PORT/SCHEME son para el servidor Reverb y la publicación
# server-side (127.0.0.1:8080 detrás de Nginx).
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=https://aldiaproyect.com,https://www.aldiaproyect.com
REVERB_PUBLIC_HOST=aldiaproyect.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
# VITE_* son los valores que se compilan en el frontend (dominio público).
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=aldiaproyect.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# CORS - Allowed Origins (comma-separated for multiple domains)
CORS_ALLOWED_ORIGINS=https://aldiaproyect.com
CORS_MAX_AGE=86400

# SANCTUM - API para clientes no-browser (app Flutter, agentes de IA)
SANCTUM_TOKEN_PREFIX=aldia_
SANCTUM_EXPIRATION_MINUTES=43200
SANCTUM_STATEFUL_DOMAINS=aldiaproyect.com

# CURRENCY CONVERSION
CLP_TO_USD_RATE=0.0011

# SII - Certificado Digital (.pfx)
SII_CERT_PATH=
SII_CERT_PASSWORD=
SII_RUT_EMISOR=

# SII - Web Services SOAP (producción real)
SII_SEMILLA_URL=https://palena.sii.cl/cgi_rtc/RTC/gettoken.cgi
SII_TOKEN_URL=https://palena.sii.cl/cgi_rtc/RTC/gettoken.cgi
SII_ENVIO_DTE_URL=https://palena.sii.cl/cgi_rtc/RTC/recrecep01.cgi
